---
import BaseLayout from '../layouts/Base.astro';
import FitToWidth from '../components/FitToWidth.astro';
---

<BaseLayout {...Astro.props}>
  <div class="page-home container">
    <div class="suptitles">'sup? I'm</div>
    <FitToWidth class="title display-1">Maarten Van Hoof</FitToWidth>
    <div class="subtitles">
      <div>Defender of the web</div>
      <div class="bullet">&bull;</div>
      <div>Design Engineer <a href="https://essent.nl">Essent</a></div>
      <div class="bullet">&bull;</div>
      <div><a href="https://roycetheband.com">Keeper of the riff</a></div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-home {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
    gap: var(--space);
    text-align: center;
    container: page-home / inline-size;
  }

  .title {
    margin-block-end: -3%;
  }

  .subtitles {
    display: flex;
    gap: calc(var(--space) / 2);
    justify-content: space-between;

    @container page-home (width < 650px) {
      flex-direction: column;
    }
  }

  .bullet {
    @container page-home (width < 800px) {
      display: none;
    }
  }
</style>
