---
import { ClientRouter } from 'astro:transitions';
import { Head } from 'astro-capo';
import spaceGroteskVariableWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';

import Seo from '../components/Seo.astro';
import Header from '../components/App/Header.astro';
import Footer from '../components/App/Footer.astro';
import SvgSprite from '../components/SvgSprite.astro';

import '../styles/app.css';

interface BaseLayoutProps {
  content: any;
  preloads: {
    rel: string;
    as: string;
    type: string;
    imagesizes: string;
    media: string;
    imagesrcset: string;
  }[];
  frontmatter: {
    headerInverse?: boolean;
  };
}

const isProd = import.meta.env.PROD;
const { content, preloads, frontmatter } = Astro.props as BaseLayoutProps;
---

<!doctype html>
<html lang="en">
  <Head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    <meta http-equiv="Accept-CH" content="DPR, Viewport-Width, Width" />
    <meta name="apple-mobile-web-app-title" content="mrtnvh" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#000000" />
    <link rel="preload" as="font" type="font/woff2" href={spaceGroteskVariableWoff2} crossorigin="anonymous" />
    <ClientRouter />
  </Head>

  <>
    {
      preloads &&
        preloads.map(({ rel, as, type, imagesizes, media, imagesrcset }) => (
          <link rel={rel} as={as} type={type} imagesizes={imagesizes} media={media} imagesrcset={imagesrcset} />
        ))
    }

    {content?.redirect && <meta http-equiv="refresh" content={`0;URL='${content.redirect}'`} />}
  </>

  <Seo {...Astro.props} />

  <script>
    window.addEventListener('beforeinstallprompt', (event) => {
      event.preventDefault();
    });

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }
  </script>

  <body>
    <div class="svg-sprite">
      <SvgSprite />
    </div>
    <div class="layout">
      {
        content?.redirect ? (
          <main class="centered" data-testid="redirect">
            Redirecting to {content.redirect}
          </main>
        ) : (
          <>
            <Header inverse={frontmatter?.headerInverse} />
            <main>
              <slot />
            </main>
            <Footer />
          </>
        )
      }
    </div>
    <script>
      import '../js/main.js';
    </script>
    {isProd && <script is:inline defer data-domain="mrtnvh.com" data-api="/api/event" src="/js/stats" />}
    <style>
      .svg-sprite {
        display: none;
      }

      .layout {
        width: 100%;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
        max-inline-size: var(--layout-max-inline-size);
        margin-inline: auto;
      }

      main {
        display: flex !important;
        flex-direction: column;
        outline: 0;
      }

      .centered {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      main,
      .portal {
        flex-grow: 1;
      }

      .portal {
        display: flex;
        flex-direction: column;
        overflow: hidden;

        &:empty {
          display: none;
        }
      }
    </style>
  </body>
</html>
