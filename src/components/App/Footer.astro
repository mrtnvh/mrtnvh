---
import Social from './Social.astro';

const yearNow = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="copyright">&copy; {yearNow} Maarten Van Hoof</div>
    <Social />
    <div class="peace">
      <svg aria-label="Peace">
        <use href="#peace"></use>
      </svg>
      <div class="ally">🏳️‍🌈</div>
    </div>
  </div>
</footer>

<style>
  footer {
    font-size: var(--font-size-xs);
    padding-block: var(--step-4);
    color: var(--foreground-color);
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;

    @media (width >= 800px) {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .peace {
    justify-content: flex-end;
    display: flex;
    align-items: center;
    margin-block-start: calc(var(--grid-gap-y) / 4);

    svg {
      height: 1rem;
    }

    @media (width >= 800px) {
      margin-top: 0;
    }
  }

  .ally {
    font-size: var(--font-size-base);
  }
</style>
