---
type NavLink = {
  key: string;
  href: string;
  title: string;
};

const currentPage = (link: NavLink) => {
  const url = new URL(Astro.request.url);
  if (link.href === '/') {
    return url.pathname === '/' || url.pathname.includes('topics');
  }
  return url.pathname.startsWith(link.href);
};

const links: NavLink[] = [
  {
    key: 'articles',
    href: '/articles',
    title: 'Articles',
  },
  {
    key: 'events',
    href: '/events',
    title: 'Events',
  },
  {
    key: 'about',
    href: '/about',
    title: 'About',
  },
];
---

<nav id="nav" class="nav" transition:name="nav">
  {
    links.map((link) => (
      <a href={link.href} data-testid={`navigation-${link.key}`} data-page-current={currentPage(link)}>
        {link.title}
      </a>
    ))
  }
</nav>

<style>
  .nav {
    font-size: var(--font-size-sm);
    display: flex;
    align-items: center;
    gap: calc(var(--grid-gap-x) / 2);
    justify-content: flex-end;
    position: relative;

    a {
      white-space: nowrap;
      padding: 0 0.33em;

      &[data-page-current='true'],
      &:focus,
      &:hover {
        background-color: var(--foreground-color);
        color: var(--background-color);
      }
    }
  }
</style>
